---
import { getCollection, render } from "astro:content";
import Layout from "@/components/layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <article>
    <header>
      <h1 class="post-title">
        {post.data.title}
      </h1>
      <h2 class="post-description">
        {post.data.description}
      </h2>
      <p class="post-date">
        by {post.data.author},{' '}
        {new Date(post.data.date).toLocaleDateString("en-GB",  {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </p>
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  article {
    margin-top: 4rem;
    padding: 0 .75rem;
    display: flex;
    flex-direction: column;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 4rem;
  }
  header {
    max-width: 38rem;
    width: 100%;
    margin: 0 auto;
    grid-column: 2 / span 2;
  }
  .post-title {
    font-size: 1.5rem;
    line-height: 1;
    margin: 0;
  }
  .post-description {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
    font-weight: normal;
  }
  .post-date {
    opacity: .6;
    font-size: 0.875rem;
    margin: 0;
  }
  .content {
    max-width: 38rem;
    grid-column: 2 / span 2;
    margin: 0 auto 8rem;
    font-family: Georgia, 'Times New Roman', Times, serif;
  }
  .content :global(p) {
    color: var(--tandoori-800);
    line-height: 1.5;
    margin: 0 0 1.5rem;
    text-wrap: pretty;
    font-size: 1.125rem;
  }
  .content :global(p:first-of-type) {
    text-indent: 0;
  }
  .content :global(img) {
    max-width: 100%;
    border: .5rem solid white;
    display: block;
    margin-left: -.5rem;
  }
  .content :global(.footnotes h2) {
    margin-top: 4rem;
  }
  .content :global(.footnotes ol) {
    padding-left: .75rem
  }

  @media screen and (min-width: 1024px) {
    article {
      display: grid;
    }
    .content :global(.footnotes ol) {
      padding-left: 0;
    }
  }

</style>
