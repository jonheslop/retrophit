---
import { getCollection } from "astro:content";
import Layout from "@/components/layout.astro";

const posts = (await getCollection("posts")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Welcome">
  <!-- <div class="intro">
    <img class="house" src="/house.svg" alt="Our new house" />
  	<p>Documenting our journey rennovating a Victorian house in East London to <a href="https://passipedia.org/certification/enerphit">EnerPHit</a> level.</p>
  </div> -->

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`} class="post-preview">
            <h2>
              {post.data.title}
            </h2>
            <h3>{post.data.description}</h3>
            <p>
              by {post.data.author},{' '}
              <datetime datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}</datetime>
              </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .intro {
    font-weight: bold;
    background-color: var(--hotcaramel-600);
    padding: 4rem .75rem;
    display: flex;
    align-items: start;
    flex-direction: column;
    gap: 4rem;
  }
  .intro p {
    text-wrap: balance;
    max-width: 48rem;
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0;
  }
  .house {
    max-width: 16rem;

  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-preview {
    display: block;
    text-decoration: none;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--hotcaramel-600);
  }

  .post-preview:hover,
  .post-preview:focus {
    background-color: rgba(255, 255, 255, .2);
   	box-shadow:
		5px 5px rgba(255, 255, 255, .1),
		-5px 5px rgba(255, 255, 255, .1),
		-5px -5px rgba(255, 255, 255, .1),
		5px -5px rgba(255, 255, 255, .1);
  }

  .post-preview h2 {
    font-size: 1.5rem;
    line-height: 1;
    margin: 0 0 2rem;
  }

  .post-preview h3 {
    margin: 0;
    line-height: 1.5;
    font-size: 1rem;
    font-weight: normal;
  }

  .post-preview p {
    display: block;
    font-size: 0.875rem;
    opacity: .6;
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .intro {
      padding: 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .intro p {
      font-size: 3rem;
    }
    .house {
      place-self: end;
    }
  }
</style>
