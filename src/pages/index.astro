---
import { getCollection } from "astro:content";
import Layout from "@/components/layout.astro";

const posts = (await getCollection("posts")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="RetroPHit – retrofitting a Victorian house to make it beautiful and energy efficient"
  description="Bec and Jon document their journey renovating a Victorian house in East London to the EnerPHit standard"
>
  <div class="intro">
     	<p>Documenting our journey renovating a Victorian house in East London to the <a href="https://passipedia.org/certification/enerphit">EnerPHit</a> standard</p>
  </div>

  <h2 class="section-heading">Recent posts</h2>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`} class="post-preview">
            <h3 class="post-title">
              {post.data.title}
            </h3>
            <p class="post-description">{post.data.description}</p>
            <p class="post-date">
              by {post.data.author},{' '}
              <time datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "long",
              })}</time>
              </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .intro {
    margin-bottom: 4rem;
  }
  .intro p {
    font-weight: bold;
    text-wrap: balance;
    font-size: 2rem;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -.0125em;
  }

  .section-heading {
    margin: 1.33em 0;
    font-size: .75rem;
    font-family: var(--font-soehne);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: .25em;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .post-preview {
    display: block;
    text-decoration: none;
    padding-bottom: .75rem;
    border-bottom: 2px solid var(--ferntastic-700);
    border-radius: 0;
  }

  .post-preview:hover,
  .post-preview:focus {
    background-color: rgba(255, 255, 255, .2);
   	box-shadow:
		5px 5px rgba(255, 255, 255, .1),
		-5px 5px rgba(255, 255, 255, .1),
		-5px -5px rgba(255, 255, 255, .1),
		5px -5px rgba(255, 255, 255, .1);
  }

  @media screen and (min-width: 768px) {
    .intro p {
      /*font-size: 3rem;*/
    }
  }
</style>
