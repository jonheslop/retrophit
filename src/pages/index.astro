---
import { getCollection } from "astro:content";
import Layout from "@/components/layout.astro";

const posts = (await getCollection("posts")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Welcome">
  <div class="intro">
    <img class="house" src="/house.svg" alt="Our new house" />
  	<p>Documenting our journey rennovating a Victorian house in East London to <a href="https://passipedia.org/certification/enerphit">EnerPHit</a> level.</p>
  </div>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`} class="post-preview">
            <h3>
              {post.data.title}
            </h3>
            <datetime datetime={new Date(post.data.date).toISOString()}>
              {new Date(post.data.date).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </datetime>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .intro {
    font-weight: bold;
    background-color: var(--hotcaramel-600);
    padding: 4rem .75rem;
    display: flex;
    align-items: start;
    flex-direction: column;
    gap: 2rem;
  }
  .intro p {
    text-wrap: balance;
    max-width: 48rem;
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0;
  }
  .house {
    max-width: 16rem;
  }
  .post-list {
    list-style: none;
    padding: 4rem .75rem;
  }
  .post-preview {
    display: block;
    text-decoration: none;
    border-bottom: 4px solid var(--hotcaramel-600);
    max-width: 32rem;
  }
  .post-preview h3 {
    font-size: 3rem;
    line-height: 1;
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .intro {
      padding: 4rem;
      flex-direction: row;
      align-items: end;
    }
    .intro p {
      font-size: 3rem;
    }
    .post-list {
      padding: 4rem;
    }
  }
</style>
