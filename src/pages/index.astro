---
import { getCollection } from "astro:content";
import Layout from "@/components/layout.astro";

const posts = (await getCollection("posts")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Welcome">
  <div class="intro">
     	<p>Documenting our journey rennovating a Victorian house in East London to the <a href="https://passipedia.org/certification/enerphit">EnerPHit</a> standard</p>
  </div>

  <h4>Recent posts</h4>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`} class="post-preview">
            <h2>
              {post.data.title}
            </h2>
            <h3>{post.data.description}</h3>
            <p>
              by {post.data.author},{' '}
              <datetime datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}</datetime>
              </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .intro {
    margin-bottom: 4rem;
  }
  .intro p {
    font-weight: bold;
    text-wrap: balance;
    font-size: 2rem;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -.0125em;
  }

  h4 {
    font-size: .75rem;
    font-family: var(--font-soehne);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: .25em;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-preview {
    display: block;
    text-decoration: none;
    padding-bottom: .75rem;
    border-bottom: 2px solid var(--ferntastic-700);
  }

  .post-preview:hover,
  .post-preview:focus {
    background-color: rgba(255, 255, 255, .2);
   	box-shadow:
		5px 5px rgba(255, 255, 255, .1),
		-5px 5px rgba(255, 255, 255, .1),
		-5px -5px rgba(255, 255, 255, .1),
		5px -5px rgba(255, 255, 255, .1);
  }

  .post-preview h2 {
    font-size: 2rem;
    line-height: 1;
    margin: 0 0 2rem;
    letter-spacing: -.0125em;
  }

  .post-preview h3 {
    margin: 0;
    line-height: 1.5;
    font-size: 1.25rem;
    font-weight: normal;
    font-style: italic;
  }

  .post-preview p {
    display: block;
    font-size: 0.875rem;
    opacity: .6;
    margin: .75em 0 0;
    font-family: var(--font-soehne);
  }

  @media screen and (min-width: 768px) {
    .intro p {
      /*font-size: 3rem;*/
    }
    .house {
      place-self: end;
    }
  }
</style>
