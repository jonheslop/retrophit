---
interface Props {
	title: string;
	description?: string;
	author?: string;
	date?: Date;
}

const { title, description, author, date } = Astro.props;
---

<article>
  <header>
    <h1 class="post-title">
      {title}
    </h1>
    {description && (
      <h2 class="post-description">
        {description}
      </h2>
    )}
    {author && date && (
      <p class="post-date">
        by {author},{' '}
        <time datetime={new Date(date).toISOString()}>{new Date(date).toLocaleDateString("en-GB", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}</time>
      </p>
    )}
  </header>
  <div class="content">
    <slot />
  </div>
</article>

<style>
  header {
    width: 100%;
    margin: 0 0 4rem;
    padding-bottom: .75rem;
    border-bottom: 2px solid var(--ferntastic-700);
  }
  .content {
    max-width: 36rem;
    margin: 0 0 8rem;
  }
  .content :global(p) {
    line-height: 1.5;
    margin: 0 0 1.5rem;
    text-wrap: pretty;
    font-size: 1.125rem;
  }
  .content :global(p:first-of-type) {
    text-indent: 0;
  }
  .content :global(img) {
    max-width: 100%;
    border: .5rem solid white;
    display: block;
    margin-left: -.5rem;
  }
  .content :global(.footnotes h2) {
    margin-top: 4rem;
  }
  .content :global(.footnotes ol) {
    padding-left: .75rem
  }

  @media screen and (min-width: 1024px) {
    .content :global(.footnotes ol) {
      padding-left: 0;
    }
  }
</style>
