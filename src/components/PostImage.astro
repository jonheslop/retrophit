---
interface Props {
	src: string;
	alt?: string;
	title?: string;
}

const { src, alt, title } = Astro.props;
---

{
  title ? (
    <figure>
      <img src={src} alt={alt} />
      <figcaption>{alt}</figcaption>
    </figure>
  ) : (
    <img src={src} alt={alt} />
  )
}

<style>
  figure {
    margin: 2rem 0;
    border: 4px solid rgb(255 255 255 / .9);;
    border-radius: .125rem;
  }
  figure img {
    margin: 0;
    border: none;
    border-radius: 0;
  }
  figcaption {
    font-size: .75rem;
    line-height: 1rem;
    color: rgb(0 0 0 / .7);
    padding: .5rem .25rem .25rem;
    background: rgb(255 255 255 / .9);
    font-feature-settings: "case";
    text-wrap: balance;
  }
</style>
