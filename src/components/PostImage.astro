---
import { inferRemoteSize } from "astro:assets";

interface Props {
	src: string;
	alt?: string;
	title?: string;
}

const { src, alt, title } = Astro.props;

// Read dimensions at build time so the browser can reserve space (avoids layout shift)
let width: number | undefined;
let height: number | undefined;
try {
	({ width, height } = await inferRemoteSize(src));
} catch {
	// Fall back to no dimensions rather than failing the build
}

const imgProps = {
	src,
	alt,
	width,
	height,
	loading: "lazy",
	decoding: "async",
} as const;
---

{
  title ? (
    <figure>
      <img {...imgProps} />
      <figcaption>{alt}</figcaption>
    </figure>
  ) : (
    <img {...imgProps} />
  )
}

<style>
  img {
    height: auto;
  }
  figure {
    margin: 2rem 0;
    border: 4px solid rgb(255 255 255 / .9);;
    border-radius: .125rem;
  }
  figure img {
    margin: 0;
    border: none;
    border-radius: 0;
  }
  figcaption {
    font-size: .75rem;
    line-height: 1rem;
    color: rgb(0 0 0 / .7);
    padding: .5rem .25rem .25rem;
    background: rgb(255 255 255 / .9);
    font-feature-settings: "case";
    text-wrap: balance;
  }
</style>
