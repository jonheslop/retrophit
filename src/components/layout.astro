---
import "@/styles/main.css";
import { Font } from "astro:assets";

interface Props {
	title: string;
}

const { title } = Astro.props;

const lastUpdated = new Date().toLocaleDateString("en-GB", {
	year: "numeric",
	month: "long",
	day: "numeric",
	hour: "numeric",
	minute: "numeric",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | retroPHit.haus</title>
    <Font cssVariable="--font-plantijn" preload />
    <Font cssVariable="--font-soehne" preload />
  </head>
  <body>
    <section>
      <header>
        <img class="house" src="/house.svg" alt="Our new house" />
        <h1>
          <a href="/">RetroPHit</a>
        </h1>

        <nav>
          <ul>
            <li><a href="/about">About</a></li>
          </ul>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </section>
   <footer>
     <div>
      <p>Bec and Jon have been bodging DIY projects since 2020</p>
      <p>Last updated on {lastUpdated} GMT</p>
      <p>&copy; {new Date().getFullYear()} Jon Heslop</p>
     </div>
   </footer>
  </body>
</html>

<style>
  body {
    color: var(--ferntastic-950);
    font-family: var(--font-plantijn);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.25;
    padding: 0;
    margin: 0;
    background-color: var(--ferntastic-200);
    font-feature-settings: "ss02" 1, "calt";
  }

  section {
    background-color: var(--ferntastic-200);
    background-image: url("/noise.svg");
    background-repeat: repeat;
    background-size: 100px;
    background-attachment: fixed;
    position: relative;
    z-index: 1;
    padding: 4rem 8rem;
    display: grid;
    grid-template-columns: 1fr 3fr;
    place-items: start;
    gap: 0 4rem;
    min-height: 100vh;
    margin-bottom: 10rem;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: right;
  }

  header h1 {
    font-size: 1.5rem;
    line-height: 1;
    margin: 0;
    font-weight: 900;
  }

  header h1 a {
    text-decoration: none;
  }
  main {
    margin-bottom: 4rem;
    width: 100%;
    max-width: 38rem;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
    justify-content: end;
    font-family: var(--font-soehne);
    font-size: 0.875rem;
  }

  footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 0;
    background-color: var(--ferntastic-950);
    color: var(--ferntastic-100);
    padding: 1rem .75rem;
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 0 4rem;
  }

  footer div {
    grid-column: 2;
  }

  footer p {
    font-family: var(--font-soehne);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    opacity: .6;
  }

  @media screen and (min-width: 768px) {
    footer {
      padding: 1rem 8rem;
      flex-direction: row;
    }
  }
  .house {
    width: 12rem;
  }
</style>
