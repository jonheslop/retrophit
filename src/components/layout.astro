---
import "@/styles/main.css";

interface Props {
	title: string;
}

const { title } = Astro.props;

const lastUpdated = new Date().toLocaleDateString("en-GB", {
	year: "numeric",
	month: "long",
	day: "numeric",
	hour: "numeric",
	minute: "numeric",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | retroPHit.haus</title>
  </head>
  <body>
    <section>
      <header>
        <h1>
          <a href="/">RetroPHit</a>
        </h1>
        <nav>
          <ul>
            <li><a href="/about">About</a></li>
          </ul>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </section>
   <footer>
     <p>Bec and Jon have been bodging DIY since 2020</p>
     <p>Last updated on {lastUpdated}</p>
     <p>&copy; {new Date().getFullYear()} Jon Heslop</p>
   </footer>
  </body>
</html>

<style>
  body {
    background-color: var(--tandoori-50);
    color: var(--tandoori-900);
    font-family: sans-serif;
    font-size: 1rem;
    line-height: 1.25;
    padding: 0;
    margin: 0;
  }
  section {
    padding: 4rem 8rem;
    display: grid;
    grid-template-columns: 1fr 3fr;
    place-items: start;
    gap: 0 4rem;
    min-height: 100vh;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  header h1 {
    font-size: 1.5rem;
    line-height: 1;
    margin: 0;
  }

  header h1 a {
    text-decoration: none;
  }
  main {
    margin-bottom: 4rem;
    width: 100%;
    max-width: 38rem;

  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
  }

  footer {
    background-color: var(--tandoori-900);
    color: var(--tandoori-50);
    padding: 1rem .75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.875rem;
  }

  @media screen and (min-width: 768px) {
    footer {
      padding: 1rem 4rem;
      flex-direction: row;
    }
  }
</style>
